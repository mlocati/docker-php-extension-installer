            "latestVersion": {
                "source": "webPage",
                "url": "https://builds.r2.relay.so/meta/latest",
                "regex": "/^v?(?<version>\\d+(?:\\.\\d+)+)/"
            }
        },
        "saxon": {
            "name": "SaxonC",
            "pinnedVersion": false,
            "url": "https://www.saxonica.com/download/c.xml",
            "latestVersion": {
                "source": "webPage",
                "url": "https://www.saxonica.com/download/c.xml",
                "regex": "/\\/SaxonCEE-linux-x86_64-(?<version>\\d+(?:-\\d+)+)\\.zip\\b/"
            }
        },
        "snappy": {
            "name": "php-ext-snappy",
            "pinnedVersion": true,
            "url": "https://github.com/kjdev/php-ext-snappy/tags",
            "latestVersion": {
                "source": "gitTags",
                "repository": "https://github.com/kjdev/php-ext-snappy"
            }
        },
        "snuffleupagus": {
            "name": "snuffleupagus",
            "pinnedVersion": true,
            "url": "https://github.com/jvoisin/snuffleupagus/releases",
            "latestVersion": {
                "source": "gitTags",
                "repository": "https://github.com/jvoisin/snuffleupagus"
            }
        },
        "sourceguardian": {
            "name": "SourceGuardian Loader",
            "pinnedVersion": false,
            "url": "https://www.sourceguardian.com/loaders.html",
            "latestVersion": {
                "source": "webPage",
                "url": "https://www.sourceguardian.com/loaders.html",
                "regex": "/loaders\\.linux-x86_64\\.tar\\.bz2\\.md5.*?<span[^>]*>\\s*(?<version>\\d+(?:\\.\\d+)+)\\s*</s"
            }
        },
        "spx": {
            "name": "php-spx",
            "pinnedVersion": true,
            "url": "https://github.com/NoiseByNorthwest/php-spx/tags",
            "latestVersion": {
                "source": "gitTags",
                "repository": "https://github.com/NoiseByNorthwest/php-spx"
            }
        },
        "tideways": {

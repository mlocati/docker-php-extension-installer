{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Libraries and PHP extensions downloaded manually by install-php-extensions",
    "type": "object",
    "required": [
        "libraries",
        "extensions"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "libraries": {
            "description": "The libraries used by PHP extensions: keys are the suffixes of the IPE_LIBVERSION_... variables (for the libraries whose version is pinned)",
            "type": "object",
            "propertyNames": {
                "pattern": "^[A-Z0-9]+$"
            },
            "additionalProperties": {
                "type": "object",
                "required": [
                    "name",
                    "pinnedVersion",
                    "usedBy",
                    "latestVersion"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "$ref": "#/$defs/name"
                    },
                    "pinnedVersion": {
                        "$ref": "#/$defs/pinnedVersion"
                    },
                    "usedBy": {
                        "description": "The PHP extensions that use the library",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "minItems": 1
                    },
                    "notes": {
                        "description": "Notes shown in README.md (markdown)",
                        "type": "string"
                    },
                    "url": {
                        "$ref": "#/$defs/url"
                    },
                    "latestVersion": {
                        "$ref": "#/$defs/latestVersion"
                    },
                    "skipCheck": {
                        "$ref": "#/$defs/skipCheck"
                    },
                    "skipTest": {
                        "$ref": "#/$defs/skipTest"
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "pinnedVersion": {
                                    "const": false
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "notes": false,
                                "skipTest": false
                            }
                        }
                    }
                ]
            }
        },
        "extensions": {
            "description": "The PHP extensions downloaded outside PECL: keys are the names of the PHP extensions",
            "type": "object",
            "propertyNames": {
                "pattern": "^[a-z0-9_]+$"
            },
            "additionalProperties": {
                "type": "object",
                "required": [
                    "name",
                    "pinnedVersion",
                    "latestVersion"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "$ref": "#/$defs/name"
                    },
                    "pinnedVersion": {
                        "$ref": "#/$defs/pinnedVersion"
                    },
                    "url": {
                        "$ref": "#/$defs/url"
                    },
                    "latestVersion": {
                        "$ref": "#/$defs/latestVersion"
                    },
                    "skipCheck": {
                        "$ref": "#/$defs/skipCheck"
                    },
                    "skipTest": {
                        "$ref": "#/$defs/skipTest"
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "pinnedVersion": {
                                    "const": false
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "notes": false,
                                "skipTest": false
                            }
                        }
                    }
                ]
            }
        }
    },
    "$defs": {
        "name": {
            "description": "The name of the library/source (it's also used to identify the notified updates)",
            "type": "string",
            "minLength": 1
        },
        "pinnedVersion": {
            "description": "Whether the version is defined in install-php-extensions (IPE_LIBVERSION_<key> variable for libraries, IPE_EXTVERSION_<EXTENSION> variable for PHP extensions); if false, install-php-extensions downloads the latest version",
            "type": "boolean"
        },
        "url": {
            "description": "The URL where maintainers can check the new versions",
            "type": "string",
            "format": "uri"
        },
        "skipCheck": {
            "description": "Why we don't check for new versions",
            "type": "string",
            "minLength": 1
        },
        "skipTest": {
            "description": "Why new versions are notified without testing them",
            "type": "string",
            "minLength": 1
        },
        "latestVersion": {
            "description": "How to retrieve the latest version",
            "type": "object",
            "required": [
                "source"
            ],
            "properties": {
                "source": {
                    "enum": [
                        "gitTags",
                        "gitRef",
                        "webPage",
                        "custom"
                    ]
                },
                "timeout": {
                    "description": "The maximum number of seconds for the connection and for the download",
                    "type": "integer",
                    "minimum": 1
                }
            },
            "oneOf": [
                {
                    "description": "The highest stable version among the tags of a git repository",
                    "properties": {
                        "source": {
                            "const": "gitTags"
                        },
                        "repository": {
                            "type": "string",
                            "format": "uri"
                        },
                        "ignoreTags": {
                            "description": "Regular expression of the tags to be ignored",
                            "type": "string"
                        },
                        "timeout": true
                    },
                    "required": [
                        "repository"
                    ],
                    "additionalProperties": false
                },
                {
                    "description": "The commit hash a git ref (branch) points to",
                    "properties": {
                        "source": {
                            "const": "gitRef"
                        },
                        "repository": {
                            "type": "string",
                            "format": "uri"
                        },
                        "ref": {
                            "type": "string"
                        },
                        "timeout": true
                    },
                    "required": [
                        "repository",
                        "ref"
                    ],
                    "additionalProperties": false
                },
                {
                    "description": "The highest version extracted from a web page with a regular expression: the version is the \"version\" named group (or the first capturing group); if there's a \"suffix\" named group, its value is appended to the version (<version>@<suffix>)",
                    "properties": {
                        "source": {
                            "const": "webPage"
                        },
                        "url": {
                            "type": "string",
                            "format": "uri"
                        },
                        "regex": {
                            "type": "string"
                        },
                        "timeout": true
                    },
                    "required": [
                        "url",
                        "regex"
                    ],
                    "additionalProperties": false
                },
                {
                    "description": "The value returned by the static method of the CustomLatestVersion class of scripts/check-updates.php whose name is the key of the item",
                    "properties": {
                        "source": {
                            "const": "custom"
                        },
                        "timeout": true
                    },
                    "additionalProperties": false
                }
            ]
        }
    }
}
